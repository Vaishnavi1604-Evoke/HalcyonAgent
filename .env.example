# Copy to .env and fill in. Never commit .env.
ORDER_MAILBOX=syeluri@evoketechnologies.com
POLL_SECONDS=15

# MAIL_MODE: outlook (Outlook.com or Microsoft 365 test account, signed in once with a code),
#            graph (Microsoft 365 app-only, needs admin), imap, or folder (offline demo only)
MAIL_MODE=folder

# --- Outlook test account (MAIL_MODE=outlook). Setup steps are in halcyon/outlook.py ---
OUTLOOK_CLIENT_ID=
# consumers = personal Outlook.com/Hotmail; common = personal or work; or your tenant id
OUTLOOK_TENANT=consumers
# only emails whose subject contains this text are read as orders (case-insensitive)
ORDER_SUBJECT=New order arrived

# --- Microsoft 365 via Microsoft Graph (MAIL_MODE=graph) ---
# Azure portal > App registrations > New. API permission: Microsoft Graph > Application > Mail.Read
# (admin consent), then restrict it to this one mailbox with an Exchange application access policy.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- IMAP (MAIL_MODE=imap), e.g. Gmail with an app password ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional: map real sender addresses (or domains) to client IDs
CLIENT_SENDERS=

# Optional: use Claude to read emails instead of the built-in rules
ANTHROPIC_API_KEY=

# --- Order simulator: creates each day's orders and sends them in real time ---
SIMULATOR=on
# realtime: orders arrive at their planned clock time; demo: a new order every DEMO_INTERVAL seconds
SIM_MODE=realtime
DEMO_INTERVAL=5

# --- Tracking (stages only change when a WMS or carrier event confirms them) ---
# demo mode compresses the real schedule: seconds after allocation
DEMO_PICK_SECONDS=30
DEMO_SHIP_SECONDS=90
DEMO_DELIVER_SECONDS=180
DEMO_LATE_SECONDS=60
# how often carriers E/F send batch files and how often carrier D's portal is checked (seconds)
# defaults: demo 20 / 45, realtime 1800 / 7200
#BATCH_SECONDS=
#PORTAL_SECONDS=

# Channels the order simulator creates. API orders come from the customer storefront (shop.html).
SIM_CHANNELS=EDI,Email
# demo mode: seconds of real time per business hour of transit (delivery ETA is calculated from the addresses)
DEMO_SECONDS_PER_HOUR=4
